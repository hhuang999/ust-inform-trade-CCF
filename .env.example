# Database (Neon)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Auth.js
AUTH_SECRET=""

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_PUBLIC="inform-trade-public"
R2_BUCKET_PRIVATE="inform-trade-private"
NEXT_PUBLIC_R2_PUBLIC_BASE_URL="https://pub.example.com"

# First admin
ADMIN_EMAIL=""

# Cron (Vercel) - shared secret to protect cron endpoint
CRON_SECRET=""

# AI（OpenAI 兼容；已实测 SiliconFlow + Qwen3-VL）
# 草稿生成（Step 1）：AI_DRAFT_ENABLED 开启入口；缺 AI_API_KEY/AI_CHAT_MODEL 时走离线桩。
# 真实 key 仅放 .env.local（已被 gitignore），勿填入此处。
AI_DRAFT_ENABLED="true"
AI_BASE_URL="https://api.siliconflow.cn/v1"
AI_API_KEY=""
AI_CHAT_MODEL="Qwen/Qwen3-VL-30B-A3B-Instruct"
AI_CHAT_VISION="true"

# 预留给后续 Step 2-5（本阶段不读取，仅占位）
AI_SEARCH_ENABLED="false"
AI_RECOMMENDATION_ENABLED="false"
AI_EMBEDDING_BASE_URL=""
AI_EMBEDDING_API_KEY=""
AI_EMBEDDING_MODEL=""
AI_EMBEDDING_DIM="1024"
AI_WORKER_SECRET=""
